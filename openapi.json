{
  "openapi": "3.0.1",
  "info": {
    "title": "Laptop Advisor API",
    "version": "1.0.0",
    "description": "API for providing laptop recommendations based on user specifications and budget."
  },
  "paths": {
    "/chat": {
      "post": {
        "summary": "Get laptop recommendations",
        "operationId": "getLaptopRecommendations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "description": "The user's question or specifications for a laptop."
                  }
                },
                "required": ["question"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The laptop recommendations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Recommendations based on the user's input."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
